{
  "slug": "alerta-nuevo-cliente",
  "name": "Alerta de cliente nuevo",
  "description": "Aviso interno al equipo (responsable asignado, responsables del origen y correos por defecto) cuando ingresa un cliente nuevo al CRM.",
  "category": "transactional",
  "subject": "Nuevo cliente: {{ lead_name }}{{#if lead_company}} · {{ lead_company }}{{/if}} ({{ lead_source }})",
  "preheader": "Ingresó desde {{ lead_source }} y quedó asignado a {{ assignee_name }}",
  "variables": [
    {
      "key": "recipient_name",
      "label": "Quien recibe el aviso",
      "default": "equipo",
      "sample": "Angelo"
    },
    {
      "key": "lead_name",
      "label": "Cliente",
      "default": "",
      "sample": "Camila Soto"
    },
    {
      "key": "lead_email",
      "label": "Correo del cliente",
      "default": "",
      "sample": "camila@inmobiliaria.cl"
    },
    {
      "key": "lead_phone",
      "label": "Teléfono",
      "default": "",
      "sample": "+56 9 1234 5678"
    },
    {
      "key": "lead_company",
      "label": "Empresa",
      "default": "",
      "sample": "Inmobiliaria Sur"
    },
    {
      "key": "lead_job_title",
      "label": "Cargo",
      "default": "",
      "sample": "Gerente comercial"
    },
    {
      "key": "lead_message",
      "label": "Mensaje",
      "default": "",
      "sample": "Quiero conocer sus servicios."
    },
    {
      "key": "lead_source",
      "label": "Origen",
      "default": "",
      "sample": "Sitio web"
    },
    {
      "key": "lead_stage",
      "label": "Etapa",
      "default": "",
      "sample": "Ingreso"
    },
    {
      "key": "assignee_name",
      "label": "Asignado a",
      "default": "Sin asignar",
      "sample": "Angelo Rossi"
    },
    {
      "key": "lead_created_at",
      "label": "Fecha y hora de ingreso",
      "default": "",
      "sample": "16-10-2026 10:30"
    },
    {
      "key": "lead_url",
      "label": "Enlace al cliente en el CRM",
      "default": "",
      "sample": "https://crm.mecaniq.cl/leads/1"
    }
  ],
  "design": {
    "settings": {
      "bg": "#F3F6F9",
      "contentBg": "#FFFFFF",
      "width": 600,
      "font": "Arial, Helvetica, sans-serif",
      "textColor": "#0B1522",
      "linkColor": "#027BB9",
      "radius": 16
    },
    "blocks": [
      {
        "id": "b0000018",
        "type": "header",
        "props": {
          "logoUrl": "{{LOGO_URL}}",
          "logoWidth": 150,
          "brandText": "MecaniQ",
          "brandColor": "#027BB9",
          "align": "center",
          "padY": 28,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b0000019",
        "type": "heading",
        "props": {
          "text": "Nuevo cliente: {{ lead_name }}",
          "size": 26,
          "color": "#0B1522",
          "weight": "700",
          "align": "left",
          "padY": 12,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001a",
        "type": "text",
        "props": {
          "text": "Hola {{ recipient_name }}, ingresó un cliente nuevo desde **{{ lead_source }}** y quedó asignado a **{{ assignee_name }}**.",
          "size": 16,
          "color": "",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001b",
        "type": "text",
        "props": {
          "text": "**{{ lead_name }}**{{#if lead_job_title}} · {{ lead_job_title }}{{/if}}{{#if lead_company}}\n{{ lead_company }}{{/if}}\n\nCorreo: {{ lead_email }}{{#if lead_phone}}\nTeléfono: {{ lead_phone }}{{/if}}\nEtapa: {{ lead_stage }} · {{ lead_created_at }}",
          "size": 15,
          "color": "",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 16,
          "padX": 32,
          "bg": "#F3F6F9"
        }
      },
      {
        "id": "b000001c",
        "type": "text",
        "props": {
          "text": "{{#if lead_message}}Mensaje:\n\n«{{ lead_message }}»{{/if}}",
          "size": 15,
          "color": "#5B6B7C",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001d",
        "type": "button",
        "props": {
          "label": "Ver cliente en el CRM",
          "href": "{{ lead_url }}",
          "bg": "#027BB9",
          "color": "#FFFFFF",
          "radius": 999,
          "size": 16,
          "align": "center",
          "fullWidth": false,
          "padY": 20,
          "padX": 32,
          "rowBg": ""
        }
      },
      {
        "id": "b000001e",
        "type": "text",
        "props": {
          "text": "Responder rápido marca la diferencia: contáctalo cuanto antes.",
          "size": 13,
          "color": "#8A98A8",
          "lineHeight": 1.6,
          "align": "center",
          "padY": 6,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001f",
        "type": "footer",
        "props": {
          "company": "{{ company_name }}",
          "address": "{{ADDRESS}}",
          "legal": "Recibes este correo porque tienes una cuenta o solicitud en MecaniQ.",
          "showUnsubscribe": false,
          "unsubscribeText": "Darme de baja",
          "showView": false,
          "color": "#8A8A8A",
          "align": "center",
          "padY": 24,
          "padX": 32,
          "bg": "#FAFAFA"
        }
      }
    ]
  },
  "html": "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<style>\nbody{margin:0;padding:0;-webkit-text-size-adjust:100%}\nimg{border:0;outline:none;text-decoration:none}\na{color:#027BB9}\n@media only screen and (max-width:620px){.col{display:block!important;max-width:100%!important;width:100%!important;padding:0 0 16px 0!important}.px{padding-left:20px!important;padding-right:20px!important}}\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#F3F6F9;font-family:Arial, Helvetica, sans-serif;color:#0B1522\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F3F6F9\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border-radius:16px;overflow:hidden\">\n<tr><td class=\"px\" style=\"padding:28px 32px;\"><div style=\"text-align:center\"><img src=\"{{LOGO_URL}}\" width=\"150\" alt=\"MecaniQ\" style=\"display:inline-block;width:150px;max-width:100%;height:auto;border:0\"></div></td></tr>\n<tr><td class=\"px\" style=\"padding:12px 32px;\"><h1 style=\"margin:0;font-size:26px;line-height:1.25;font-weight:700;color:#0B1522;text-align:left\">Nuevo cliente: {{ lead_name }}</h1></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:16px;line-height:1.6;color:#0B1522;text-align:left\">Hola {{ recipient_name }}, ingresó un cliente nuevo desde <strong>{{ lead_source }}</strong> y quedó asignado a <strong>{{ assignee_name }}</strong>.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:16px 32px;background-color:#F3F6F9;\"><div style=\"font-size:15px;line-height:1.6;color:#0B1522;text-align:left\"><strong>{{ lead_name }}</strong>{{#if lead_job_title}} · {{ lead_job_title }}{{/if}}{{#if lead_company}}<br>{{ lead_company }}{{/if}}<br><br>Correo: {{ lead_email }}{{#if lead_phone}}<br>Teléfono: {{ lead_phone }}{{/if}}<br>Etapa: {{ lead_stage }} · {{ lead_created_at }}</div></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:15px;line-height:1.6;color:#5B6B7C;text-align:left\">{{#if lead_message}}Mensaje:<br><br>«{{ lead_message }}»{{/if}}</div></td></tr>\n<tr><td class=\"px\" style=\"padding:20px 32px;\"><div style=\"text-align:center\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"display:inline-table;\"><tr><td align=\"center\" bgcolor=\"#027BB9\" style=\"background-color:#027BB9;border-radius:999px\"><a href=\"{{ lead_url }}\" target=\"_blank\" style=\"display:block;padding:14px 28px;font-size:16px;line-height:1.2;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:999px\">Ver cliente en el CRM</a></td></tr></table></div></td></tr>\n<tr><td class=\"px\" style=\"padding:6px 32px;\"><div style=\"font-size:13px;line-height:1.6;color:#8A98A8;text-align:center\">Responder rápido marca la diferencia: contáctalo cuanto antes.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:24px 32px;background-color:#FAFAFA;\"><div style=\"font-size:12px;line-height:1.7;color:#8A8A8A;text-align:center\"><strong>{{ company_name }}</strong><br>{{ADDRESS}}<br>Recibes este correo porque tienes una cuenta o solicitud en MecaniQ.</div></td></tr>\n</table>\n</td></tr></table>\n</body>\n</html>"
}
