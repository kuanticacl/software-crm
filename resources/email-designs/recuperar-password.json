{
  "slug": "recuperar-password",
  "name": "Recuperar contraseña",
  "description": "Enlace para restablecer la contraseña (flujo «¿Olvidaste tu contraseña?»).",
  "category": "transactional",
  "subject": "Restablece tu contraseña del CRM de INTEGRALEADS",
  "preheader": "Usa este enlace para crear una nueva contraseña",
  "variables": [
    {
      "key": "first_name",
      "label": "Nombre",
      "default": "",
      "sample": "María"
    },
    {
      "key": "reset_url",
      "label": "Enlace para restablecer",
      "default": "",
      "sample": "https://crm.integraleads.cl/reset-password/token"
    },
    {
      "key": "expires_minutes",
      "label": "Minutos de vigencia",
      "default": "60",
      "sample": "60"
    }
  ],
  "design": {
    "settings": {
      "bg": "#F3F4FB",
      "contentBg": "#FFFFFF",
      "width": 600,
      "font": "Arial, Helvetica, sans-serif",
      "textColor": "#171B2E",
      "linkColor": "#4A10A8",
      "radius": 16
    },
    "blocks": [
      {
        "id": "b000000x",
        "type": "header",
        "props": {
          "logoUrl": "{{LOGO_URL}}",
          "logoWidth": 150,
          "brandText": "INTEGRALEADS",
          "brandColor": "#6419DB",
          "align": "center",
          "padY": 28,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000y",
        "type": "heading",
        "props": {
          "text": "Restablece tu contraseña",
          "size": 26,
          "color": "#171B2E",
          "weight": "700",
          "align": "left",
          "padY": 12,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000z",
        "type": "text",
        "props": {
          "text": "Hola {{ first_name }}, recibimos una solicitud para restablecer la contraseña de tu acceso al CRM de INTEGRALEADS.",
          "size": 16,
          "color": "",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b0000010",
        "type": "button",
        "props": {
          "label": "Crear nueva contraseña",
          "href": "{{ reset_url }}",
          "bg": "#6419DB",
          "color": "#FFFFFF",
          "radius": 999,
          "size": 16,
          "align": "center",
          "fullWidth": false,
          "padY": 20,
          "padX": 32,
          "rowBg": ""
        }
      },
      {
        "id": "b0000011",
        "type": "text",
        "props": {
          "text": "El enlace vence en {{ expires_minutes }} minutos y solo se puede usar una vez.",
          "size": 13,
          "color": "#7B8299",
          "lineHeight": 1.6,
          "align": "center",
          "padY": 6,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b0000012",
        "type": "text",
        "props": {
          "text": "Si no lo solicitaste, ignora este correo: tu contraseña actual sigue funcionando.",
          "size": 13,
          "color": "#7B8299",
          "lineHeight": 1.6,
          "align": "center",
          "padY": 6,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b0000013",
        "type": "footer",
        "props": {
          "company": "{{ company_name }}",
          "address": "{{ADDRESS}}",
          "legal": "Recibes este correo porque tienes una cuenta o solicitud en INTEGRALEADS.",
          "showUnsubscribe": false,
          "unsubscribeText": "Darme de baja",
          "showView": false,
          "color": "#9A8C88",
          "align": "center",
          "padY": 24,
          "padX": 32,
          "bg": "#FBF8F6"
        }
      }
    ]
  },
  "html": "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<style>\nbody{margin:0;padding:0;-webkit-text-size-adjust:100%}\nimg{border:0;outline:none;text-decoration:none}\na{color:#4A10A8}\n@media only screen and (max-width:620px){.col{display:block!important;max-width:100%!important;width:100%!important;padding:0 0 16px 0!important}.px{padding-left:20px!important;padding-right:20px!important}}\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#F3F4FB;font-family:Arial, Helvetica, sans-serif;color:#171B2E\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F3F4FB\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border-radius:16px;overflow:hidden\">\n<tr><td class=\"px\" style=\"padding:28px 32px;\"><div style=\"text-align:center\"><img src=\"{{LOGO_URL}}\" width=\"150\" alt=\"INTEGRALEADS\" style=\"display:inline-block;width:150px;max-width:100%;height:auto;border:0\"></div></td></tr>\n<tr><td class=\"px\" style=\"padding:12px 32px;\"><h1 style=\"margin:0;font-size:26px;line-height:1.25;font-weight:700;color:#171B2E;text-align:left\">Restablece tu contraseña</h1></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:16px;line-height:1.6;color:#171B2E;text-align:left\">Hola {{ first_name }}, recibimos una solicitud para restablecer la contraseña de tu acceso al CRM de INTEGRALEADS.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:20px 32px;\"><div style=\"text-align:center\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"display:inline-table;\"><tr><td align=\"center\" bgcolor=\"#6419DB\" style=\"background-color:#6419DB;border-radius:999px\"><a href=\"{{ reset_url }}\" target=\"_blank\" style=\"display:block;padding:14px 28px;font-size:16px;line-height:1.2;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:999px\">Crear nueva contraseña</a></td></tr></table></div></td></tr>\n<tr><td class=\"px\" style=\"padding:6px 32px;\"><div style=\"font-size:13px;line-height:1.6;color:#7B8299;text-align:center\">El enlace vence en {{ expires_minutes }} minutos y solo se puede usar una vez.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:6px 32px;\"><div style=\"font-size:13px;line-height:1.6;color:#7B8299;text-align:center\">Si no lo solicitaste, ignora este correo: tu contraseña actual sigue funcionando.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:24px 32px;background-color:#FBF8F6;\"><div style=\"font-size:12px;line-height:1.7;color:#9A8C88;text-align:center\"><strong>{{ company_name }}</strong><br>{{ADDRESS}}<br>Recibes este correo porque tienes una cuenta o solicitud en INTEGRALEADS.</div></td></tr>\n</table>\n</td></tr></table>\n</body>\n</html>"
}
