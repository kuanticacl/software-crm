{
  "slug": "propuesta-comercial",
  "name": "Propuesta comercial",
  "description": "Correo con el enlace a la propuesta comercial (se usa al enviar desde Propuestas).",
  "category": "transactional",
  "subject": "Propuesta comercial: {{ proposal_title }}",
  "preheader": "Revisa tu propuesta de Vivienda en Regla",
  "variables": [
    {
      "key": "first_name",
      "label": "Nombre",
      "default": "",
      "sample": "María"
    },
    {
      "key": "proposal_title",
      "label": "Título de la propuesta",
      "default": "",
      "sample": "Marketing digital Proyecto Torre Norte"
    },
    {
      "key": "proposal_number",
      "label": "Número",
      "default": "",
      "sample": "P-2026-0001"
    },
    {
      "key": "proposal_url",
      "label": "Enlace",
      "default": "",
      "sample": "https://www.viviendaenregla.cl"
    },
    {
      "key": "valid_until",
      "label": "Válida hasta",
      "default": "",
      "sample": "30 de octubre de 2026"
    },
    {
      "key": "message",
      "label": "Mensaje",
      "default": "",
      "sample": "Adjunto la propuesta que conversamos."
    }
  ],
  "design": {
    "settings": {
      "bg": "#F6EFEB",
      "contentBg": "#FFFFFF",
      "width": 600,
      "font": "Arial, Helvetica, sans-serif",
      "textColor": "#3B2F2F",
      "linkColor": "#8A4A55",
      "radius": 16
    },
    "blocks": [
      {
        "id": "b000001q",
        "type": "header",
        "props": {
          "logoUrl": "{{LOGO_URL}}",
          "logoWidth": 150,
          "brandText": "Vivienda en Regla",
          "brandColor": "#A9606B",
          "align": "center",
          "padY": 28,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001r",
        "type": "heading",
        "props": {
          "text": "Hola {{ first_name }}, te compartimos tu propuesta",
          "size": 26,
          "color": "#3B2F2F",
          "weight": "700",
          "align": "left",
          "padY": 12,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001s",
        "type": "text",
        "props": {
          "text": "{{ message }}",
          "size": 16,
          "color": "",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001t",
        "type": "text",
        "props": {
          "text": "**{{ proposal_title }}**\nN.º {{ proposal_number }}{{#if valid_until}} · válida hasta {{ valid_until }}{{/if}}",
          "size": 15,
          "color": "#7A6A68",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001u",
        "type": "button",
        "props": {
          "label": "Ver propuesta",
          "href": "{{ proposal_url }}",
          "bg": "#A9606B",
          "color": "#FFFFFF",
          "radius": 999,
          "size": 16,
          "align": "center",
          "fullWidth": false,
          "padY": 20,
          "padX": 32,
          "rowBg": ""
        }
      },
      {
        "id": "b000001v",
        "type": "text",
        "props": {
          "text": "Desde el enlace puedes revisarla, descargarla en PDF y aceptarla en línea.",
          "size": 13,
          "color": "#9A8C88",
          "lineHeight": 1.6,
          "align": "center",
          "padY": 6,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000001w",
        "type": "footer",
        "props": {
          "company": "{{ company_name }}",
          "address": "{{ADDRESS}}",
          "legal": "Recibes este correo porque tienes una cuenta o solicitud en Vivienda en Regla.",
          "showUnsubscribe": false,
          "unsubscribeText": "Darme de baja",
          "showView": false,
          "color": "#9A8C88",
          "align": "center",
          "padY": 24,
          "padX": 32,
          "bg": "#FBF8F6"
        }
      }
    ]
  },
  "html": "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<style>\nbody{margin:0;padding:0;-webkit-text-size-adjust:100%}\nimg{border:0;outline:none;text-decoration:none}\na{color:#8A4A55}\n@media only screen and (max-width:620px){.col{display:block!important;max-width:100%!important;width:100%!important;padding:0 0 16px 0!important}.px{padding-left:20px!important;padding-right:20px!important}}\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#F6EFEB;font-family:Arial, Helvetica, sans-serif;color:#3B2F2F\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F6EFEB\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border-radius:16px;overflow:hidden\">\n<tr><td class=\"px\" style=\"padding:28px 32px;\"><div style=\"text-align:center\"><img src=\"{{LOGO_URL}}\" width=\"150\" alt=\"Vivienda en Regla\" style=\"display:inline-block;width:150px;max-width:100%;height:auto;border:0\"></div></td></tr>\n<tr><td class=\"px\" style=\"padding:12px 32px;\"><h1 style=\"margin:0;font-size:26px;line-height:1.25;font-weight:700;color:#3B2F2F;text-align:left\">Hola {{ first_name }}, te compartimos tu propuesta</h1></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:16px;line-height:1.6;color:#3B2F2F;text-align:left\">{{ message }}</div></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:15px;line-height:1.6;color:#7A6A68;text-align:left\"><strong>{{ proposal_title }}</strong><br>N.º {{ proposal_number }}{{#if valid_until}} · válida hasta {{ valid_until }}{{/if}}</div></td></tr>\n<tr><td class=\"px\" style=\"padding:20px 32px;\"><div style=\"text-align:center\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"display:inline-table;\"><tr><td align=\"center\" bgcolor=\"#A9606B\" style=\"background-color:#A9606B;border-radius:999px\"><a href=\"{{ proposal_url }}\" target=\"_blank\" style=\"display:block;padding:14px 28px;font-size:16px;line-height:1.2;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:999px\">Ver propuesta</a></td></tr></table></div></td></tr>\n<tr><td class=\"px\" style=\"padding:6px 32px;\"><div style=\"font-size:13px;line-height:1.6;color:#9A8C88;text-align:center\">Desde el enlace puedes revisarla, descargarla en PDF y aceptarla en línea.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:24px 32px;background-color:#FBF8F6;\"><div style=\"font-size:12px;line-height:1.7;color:#9A8C88;text-align:center\"><strong>{{ company_name }}</strong><br>{{ADDRESS}}<br>Recibes este correo porque tienes una cuenta o solicitud en Vivienda en Regla.</div></td></tr>\n</table>\n</td></tr></table>\n</body>\n</html>"
}
